{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "discord-verify-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-04",
	"observability": {
		"enabled": false
	},
	"upload_source_maps": true,
	"vars": {
		"TURNSTILE_SITE_KEY": "0x4AAAAAAF2qdnLWMezkxK_h"
	},
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		}
	]
}